<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	elementFormDefault="qualified">

	 <!-- 属性だけを制約する単純型 -->
	  <xs:simpleType name="ScriptType">
		<xs:restriction base="xs:string">
		  <xs:enumeration value="ps"/>
		  <xs:enumeration value="sh"/>
		  <xs:enumeration value="bash"/>
		  <xs:enumeration value="cmd"/>
		</xs:restriction>
	  </xs:simpleType>

	<!-- ルート要素 -->
	<xs:element name="kagerow-script">
		<xs:complexType>
			<xs:sequence>

				<!-- configuration -->
				<xs:element name="configuration" minOccurs="1" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="name" type="xs:string" minOccurs="1" maxOccurs="1"/>
							<xs:element name="summary" type="xs:string" minOccurs="1" maxOccurs="1"/>
							<xs:element name="mode" type="xs:string" minOccurs="1" maxOccurs="1"/>
							<xs:element name="schema" type="xs:string" minOccurs="1" maxOccurs="1"/>
							<xs:element name="cache" type="xs:string" minOccurs="0" maxOccurs="1"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				
				<!-- environment -->
				<xs:element name="environment" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="env" maxOccurs="unbounded" minOccurs="1">
								<xs:complexType>
									<xs:attribute name="name" type="xs:string" use="required" />
									<xs:attribute name="value" type="xs:string" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>

				<!-- plugins -->
				<xs:element name="plugins" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:all>
							<xs:element name="input" minOccurs="0" maxOccurs="1">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="plugin" maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="param" minOccurs="0" maxOccurs="unbounded">
														<xs:complexType mixed="true">
															<xs:attribute name="name" type="xs:string" use="required" />
														</xs:complexType>
													</xs:element>
												</xs:sequence>
												<xs:attribute name="id" type="xs:string" use="required" />
												<xs:attribute name="package" type="xs:string" use="optional" />
												<xs:attribute name="name" type="xs:string" use="required" />
												<xs:attribute name="next" type="xs:string" use="optional" />
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="output" minOccurs="0" maxOccurs="1">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="plugin" maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="param" minOccurs="0" maxOccurs="unbounded">
														<xs:complexType mixed="true">
															<xs:attribute name="name" type="xs:string" use="required" />
														</xs:complexType>
													</xs:element>
												</xs:sequence>
												<xs:attribute name="id" type="xs:string" use="required" />
												<xs:attribute name="package" type="xs:string" use="optional" />
												<xs:attribute name="name" type="xs:string" use="required" />
												<xs:attribute name="next" type="xs:string" use="optional" />
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:all>
					</xs:complexType>
				</xs:element>

				<!-- ksql -->
				<xs:element name="ksqls" minOccurs="1" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ksql" minOccurs="1" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="variable-declaration" minOccurs="0" maxOccurs="1">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="variable" minOccurs="0" maxOccurs="unbounded">
														<xs:complexType>
															<xs:attribute name="name" type="xs:string" use="required" />
															<xs:attribute name="value" type="xs:string" use="required" />
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="sql" type="xs:string" minOccurs="1" maxOccurs="1" />
									</xs:sequence>
									<xs:attribute name="id" type="xs:string" use="required" />
									<xs:attribute name="name" type="xs:string" use="required" />
									<xs:attribute name="next" type="xs:string" use="optional" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>

				<!-- command（任意だが出たら中身必須） -->
				<xs:element name="command" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<!-- environmental-variables 必須 -->
							<xs:element name="environmental-variables" minOccurs="0" maxOccurs="1">
								<xs:complexType>
									<xs:sequence>
										<!-- variable 1つ以上必須 -->
										<xs:element name="variable" minOccurs="1" maxOccurs="unbounded">
											<xs:complexType>
												<xs:attribute name="name" type="xs:string" use="required" />
												<xs:attribute name="value" type="xs:string" use="required" />
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<!-- cmd 必須 -->
							<xs:element name="cmd" minOccurs="1" maxOccurs="1">
						        <xs:complexType>
						          <xs:simpleContent>
						            <xs:extension base="xs:string">
						              <xs:attribute name="mode" type="ScriptType" use="required"/>
						            </xs:extension>
						          </xs:simpleContent>
						        </xs:complexType>
						    </xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>

			</xs:sequence>
		</xs:complexType>
	</xs:element>

</xs:schema>
